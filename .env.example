# WalletConnect project ID used by the connect wallet button.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional public app URL used for WalletConnect mobile metadata.
NEXT_PUBLIC_APP_URL=

# Optional comma-separated public RPC URLs used client-side by RainbowKit/Wagmi.
NEXT_PUBLIC_ETHEREUM_RPC_URLS=

# Dedicated secret for signed claim challenges.
# Required in production so claim signing does not share the Supabase admin key.
CLAIM_AUTH_SECRET=

# Supabase admin credentials used server-side to assign claim codes.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Optional comma-separated server-side RPC URLs used for claim eligibility checks.
ETHEREUM_RPC_URLS=
