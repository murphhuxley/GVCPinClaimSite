# WalletConnect project ID used by the connect wallet button.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional dedicated secret for signed claim challenges.
# If omitted, the server falls back to SUPABASE_SERVICE_KEY.
CLAIM_AUTH_SECRET=

# Supabase admin credentials used server-side to assign claim codes.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
